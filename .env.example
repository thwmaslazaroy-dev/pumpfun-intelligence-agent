TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PUMPFUN_DATA_PROVIDER=
X_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
DATABASE_URL=./data/pumpfun-agent.sqlite
INGESTION_INTERVAL_SECONDS=30
DISCORD_WEBHOOK_URL=
DISCORD_ALERTS_ENABLED=false
MIN_COMBINED_ALERT_SCORE=80
ALERT_COMBINED_RISK_LEVELS=LOW,MEDIUM
ALERT_EXTREME_RISK_ENABLED=true

# Step 5A — learning-mode raw log listener (read-only, not wired into ingestion)
# Public mainnet WS RPC works for low-volume learning; expect rate limits.
SOLANA_RPC_WS_URL=
# HTTP fallback used by `npm run fetch:pumpfun:txs` to call getSignaturesForAddress
# + getTransaction for the configured PUMPFUN_PROGRAM_ID. Read-only.
SOLANA_RPC_HTTP_URL=
# Canonical Pump.fun program id on Solana mainnet (verify before use):
#   6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
PUMPFUN_PROGRAM_ID=
RAW_LOG_MAX_EVENTS=25
RAW_LOG_OUTPUT_PATH=./data/raw-pumpfun-logs.jsonl

# Step 5B — CREATE discovery script (`npm run find:pumpfun:creates`)
PUMPFUN_SIGNATURE_LIMIT=500
PUMPFUN_CREATE_SEARCH_OUTPUT_PATH=./data/pumpfun-create-candidates.jsonl

# Moralis read-only token enrichment test (`npm run test:moralis:token`)
# Key is sent only via X-API-Key header — never printed or written to disk.
MORALIS_API_KEY=
MORALIS_TEST_TOKEN_MINT=

# Outcome tracker (`npm run track:token:outcome`) — persists Moralis snapshots
# to the SQLite `token_outcomes` table for backtesting. Read-only.
OUTCOME_TEST_TOKEN_MINT=

# Batch outcome tracker (`npm run track:batch:outcomes`) — reads multiple mints
# from a watchlist file and persists one outcome row per mint.
OUTCOME_WATCHLIST_PATH=./data/watchlist-mints.txt
OUTCOME_BATCH_DELAY_MS=500

# Radar HTTP-only scan (`npm run radar:scan`) — read-only Solana RPC pacing.
# RADAR_TX_FETCH_DELAY_MS sleeps before AND after each getTransaction call
# (set to 0 to disable). Use to stay under provider burst limits.
RADAR_SIGNATURE_LIMIT=50
RADAR_TX_FETCH_LIMIT=15
RADAR_TX_FETCH_DELAY_MS=750
